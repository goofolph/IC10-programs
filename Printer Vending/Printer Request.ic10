alias dPrinter d0
alias dSorter d1

define MUTEX 0
define PUBLICSP 1

define TIMEOUT 60

alias rSelfId r15
l rSelfId db ReferenceId
# get and save reference ID for Vending Housing for stack access
alias rVendingHousingId r14
define HOUSING HASH("StructureCircuitHousing")
define VENDING HASH("Vending IC Housing")
lbn rVendingHousingId HOUSING VENDING ReferenceId Average

alias rReagent r13
alias rHash r12
alias rQty r11

main:
  move rReagent HASH("Copper")
  jal checkReagent
  move rReagent HASH("Gold")
  jal checkReagent
  move rReagent HASH("Iron")
  jal checkReagent
  move rReagent HASH("Lead")
  jal checkReagent
  move rReagent HASH("Nickel")
  jal checkReagent
  move rReagent HASH("Silicon")
  jal checkReagent
  move rReagent HASH("Silver")
  jal checkReagent
  move rReagent HASH("Hydrocarbon")
  jal checkReagent
  move rReagent HASH("Constantan")
  jal checkReagent
  move rReagent HASH("Electrum")
  jal checkReagent
  move rReagent HASH("Invar")
  jal checkReagent
  move rReagent HASH("Solder")
  jal checkReagent
  move rReagent HASH("Steel")
  jal checkReagent
  move rReagent HASH("Astroloy")
  jal checkReagent
  move rReagent HASH("Hastelloy")
  jal checkReagent
  move rReagent HASH("Inconel")
  jal checkReagent
  move rReagent HASH("Stellite")
  jal checkReagent
  move rReagent HASH("Waspaloy")
  jal checkReagent

end:
  yield
  j main

checkReagent:
  # will send request to vending
  lr rQty dPrinter Required rReagent
  rmap rHash dPrinter rReagent # convert Iron to ItemIronIngot
  beqz rQty ra
  # found reagent to request
  # TODO for debugging show the hash and qty of current reagent, item, and quantity on displays
  push ra
  jal waitMutex

  # r2 is the current public sp in vending
  get r2 rVendingHousingId PUBLICSP
  put rVendingHousingId r2 rHash
  add r2 r2 1
  put rVendingHousingId r2 rQty
  add r2 r2 1
  put rVendingHousingId PUBLICSP r2
  jal clearMutex

  # wait with timeout for resources to arrive. Once timeout is done, move on. If qty of rea
  # r3 is the current check during timeout wait
  # r4 is the current required qty
  move r3 TIMEOUT
  waitLoop:
    yield
    lr r4 dPrinter Required rReagent
    bne r4 rQty endWaitLoop
    sub r3 r3 1
    bgtz r3 waitLoop
  endWaitLoop:

  pop ra
  j ra

waitMutex:
  yield
  get r2 rVendingHousingId MUTEX
  bnez r2 waitMutex
  put rVendingHousingId MUTEX rSelfId
  yield
  get r2 rVendingHousingId MUTEX
  bne r2 rSelfId waitMutex
  j ra

clearMutex:
  put rVendingHousingId MUTEX 0
  j ra