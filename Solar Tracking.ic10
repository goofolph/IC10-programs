## Setup:
## Place solar panels in any direction
## Append direction of data port to end of solar panel name.
## NOTE: 0 is North, 90 is East, 180 is South, 270 is West
## The Daylight Sensor and IC Housing should have the data port connected to the same
## cable network. Solar sensor can face any direction, adjust HOFFSET/VOFFSET accordingly.

# Adjust solar sensor direction.
define HOFFSET 180
define VOFFSET 90

# Solar names
define SOLAR0 HASH("Solar 0")
define SOLAR90 HASH("Solar 90")
define SOLAR180 HASH("Solar 180")
define SOLAR270 HASH("Solar 270")

# device types
define SOLAR HASH("StructureSolarPanel")
define SOLARDUAL HASH("StructureSolarPanelDual")
define SOLARREIN HASH("StructureSolarPanelReinforced")
define SOLARDUALREIN HASH("StructureSolarPanelDualReinforced")

# sensor
define DSENSOR HASH("StructureDaylightSensor")
define SENSOR HASH("Solar Daylight Sensor")
alias horiz r15
alias vert r14

main:
    lbn horiz DSENSOR SENSOR Horizontal 0
    lbn vert DSENSOR SENSOR Vertical 0

    add vert vert VOFFSET
    add horiz horiz HOFFSET

    move r0 horiz
    add r1 r0 90
    add r2 r0 180
    add r3 r0 270

end:
    sb SOLAR Vertical vert

    sbn SOLAR SOLAR0 Horizontal r0
    sbn SOLARDUAL SOLAR0 Horizontal r0
    sbn SOLARREIN SOLAR0 Horizontal r0
    sbn SOLARDUALREIN SOLAR0 Horizontal r0

    sbn SOLAR SOLAR90 Horizontal r1
    sbn SOLARDUAL SOLAR90 Horizontal r1
    sbn SOLARREIN SOLAR90 Horizontal r1
    sbn SOLARDUALREIN SOLAR90 Horizontal r1

    sbn SOLAR SOLAR180 Horizontal r2
    sbn SOLARDUAL SOLAR180 Horizontal r2
    sbn SOLARREIN SOLAR180 Horizontal r2
    sbn SOLARDUALREIN SOLAR180 Horizontal r2

    sbn SOLAR SOLAR270 Horizontal r3
    sbn SOLARDUAL SOLAR270 Horizontal r3
    sbn SOLARREIN SOLAR270 Horizontal r3
    sbn SOLARDUALREIN SOLAR270 Horizontal r3

    yield
    j main